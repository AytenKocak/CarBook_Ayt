@model CreateReservationDto

@{
    ViewData["Title"] = "Araç Rezervasyonu";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="col-md-8 block-9 mb-md-5">
    <form method="post" class="bg-light p-5 contact-form rounded shadow">

        <h3 class="mb-4 text-success">
            <i class="fa fa-car"></i> Araç Rezervasyonu
        </h3>
      
        <label>@ViewBag.V3</label>

        <input asp-for="CarID"
               type="number"
               min="1"
               class="form-control"
               placeholder="Araç ID giriniz">

        <div class="form-group">
            <label>Ad</label>
            <input asp-for="Name" class="form-control" placeholder="Adınız">
        </div>

        <div class="form-group">
            <label>Soyad</label>
            <input asp-for="SurName" class="form-control" placeholder="Soyadınız">
        </div>

        <div class="form-group">
            <label>E-Posta</label>
            <input asp-for="EMail" class="form-control" placeholder="E-Posta Adresiniz">
        </div>

        <div class="form-group">
            <label>Telefon</label>
            <input asp-for="Phone" class="form-control" placeholder="Telefon Numaranız">
        </div>

        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    <label>Yaş</label>
                    <input asp-for="Age" class="form-control">
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Ehliyet Yılı</label>
                    <input asp-for="DriverLicenseYear" class="form-control">
                </div>
            </div>

        </div>

        <div class="form-group">
            <label>Alış Lokasyonu</label>

            @Html.DropDownListFor(x => x.PickUpLocationID,
                (List<SelectListItem>)ViewBag.LocationList,
                "Lokasyon Seçiniz",
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Teslim Lokasyonu</label>

            @Html.DropDownListFor(x => x.DropOffLocationID,
                (List<SelectListItem>)ViewBag.LocationList,
                "Lokasyon Seçiniz",
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Açıklama</label>
            <textarea asp-for="Description"
                      rows="5"
                      class="form-control"
                      placeholder="Eklemek istediğiniz not"></textarea>
        </div>

        <button type="submit" class="btn btn-success btn-block py-3">
            <i class="fa fa-check-circle"></i> Rezervasyonu Tamamla
        </button>

    </form>
</div>