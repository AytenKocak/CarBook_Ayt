@model List<ResultLocationDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 1;
}
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Ana Sayfa Hakkımızda Alanı</h4>
                        <p class="card-subtitle mb-4">
                            Arabaların kiralanıp bırakıldığı lokasyonu tespit eden yer.
                            Araç kiralama noktalarının adresleri listedeir.
                        </p>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>                                       
                                        <th>Lokasyon</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                        <th>Haritada Göster</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <td>@item.Name</td>
                                           

                                            <td>
                                                <a href="/AdminLocation/RemoveLocation/@item.LocationID" class="btn btn-outline-danger">Sil</a>
                                            </td>
                                            <td>
                                                <a href="/AdminLocation/UpdateLocation/@item.LocationID" class="btn btn-outline-success">Güncelle</a>
                                            </td>
                                            <td>
                                                <a href="/AdminLocation/LocationDetail/@item.LocationID" class="btn btn-outline-success">Konumu Aç</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <br />
                            <a href="/AdminLocation/CreateLocation" class="btn btn-primary">Yeni Lokasyon Girişi</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>