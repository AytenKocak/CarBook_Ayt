@model CreateLocationDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
 
}
<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Lokasyon Girişi</h4>

                        <p class="card-subtitle mb-4">
                            Yeni Lokasyon Ekleyebilirsiniz

                        </p>

                        <form method="post">

                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label">Lokasyon Adı</label>
                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Lokasyon Adını Girişi Yapınız" />
                            </div>

                           

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                              Lokosyon bilgisini Kaydet
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>