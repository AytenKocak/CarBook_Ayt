@model UpdateAboutDto


@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";

}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Hakkımızda Güncelleme  Girişi</h4>

                        <p class="card-subtitle mb-4">
                            Araç Hakkımızda sayfasını buradan güncelleyebilirsiniz.

                        </p>

                        <form method="post">
                            <input type="hidden" asp-for="AboutID" />
                            <div class="form-group mb-3">
                                <label asp-for="Title" class="form-label">Başlık</label>
                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Başlık Girişi Yapınız" />
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                               <textarea rows="5" asp-for="Description" class="form-control"
                               placeholder="Açıklama Giriniz"></textarea>
                               </div>

                            <div class="form-group mb-3">
                                <label asp-for="ImageUrl" class="form-label">Video Açıklama</label>
                                <input asp-for="ImageUrl"
                                       class="form-control"
                                       placeholder="Görsel Yolunu Giriniz" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                              Hakkımda bilgisini Kaydet
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

