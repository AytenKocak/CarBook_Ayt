@model CreateAboutDto

@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";

}
<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Hakkımızda Alanı  Girişi</h4>

                        <p class="card-subtitle mb-4">
                          Hakkımızda sayfasını buradan oluşturabilirsiniz.

                        </p>

                        <form method="post">

                            <div class="form-group mb-3">
                                <label asp-for="Title" class="form-label">Başlık</label>
                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Başlık Girişi Yapınız" />
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                               <textarea rows="5" asp-for="Description"   class="form-control"  placeholder="Açıklamayı Giriniz"></textarea>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ImageUrl" class="form-label">Görsel </label>
                                <input asp-for="ImageUrl"
                                       class="form-control"
                                       placeholder="Görsel Giriniz" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                               Hakkımızda alanı bilgisini Kaydet
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>