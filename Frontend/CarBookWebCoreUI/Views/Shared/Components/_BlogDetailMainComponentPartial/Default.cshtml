@model CarBook_Ayt_Dto.BlogDtos.ResultGetBlogByIdDto

<div class="col-md-8 ftco-animate">

    <h2 class="mb-3">@Model.Title</h2>

    <p>
        @Model.Description
    </p>

    <p>
        <img src="/carbook-master/images/image_5.jpg"
             alt=""
             class="img-fluid">
    </p>

    @await Component.InvokeAsync(
        "_BlogDetailCloudTagByBlogComppnentPartial",
        new { id = ViewBag.blogid }
    )

    @await Component.InvokeAsync(
        "_BlogDetailsAuthorAboutComponentPartial",
        new { id = ViewBag.blogid }
    )

    <div class="pt-5 mt-5">

        <h3 class="mb-5">
            @ViewBag.commentCount Yorum
        </h3>

        @await Component.InvokeAsync(
            "CommentsListByBlogComponentPartial",
            new { id = ViewBag.blogid }
        )

        @*  @await Component.InvokeAsync("_AddCommentComponentPartial") *@
        @await Html.PartialAsync(
         "AddComment",
         new CarBook_Ayt_Dto.CommentDto.CreateCommentDto
         {
             BlogID = ViewBag.blogid
         }
     )

    </div>

</div>