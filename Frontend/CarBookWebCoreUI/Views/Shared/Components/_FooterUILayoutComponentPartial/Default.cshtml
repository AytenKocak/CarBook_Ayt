    @foreach(var item in Model)
    {
<footer class="ftco-footer ftco-bg-dark ftco-section">
    <div class="container">
        <div class="row mb-5">
            <div class="col-md">
                <div class="ftco-footer-widget mb-4">
                    <h2 class="ftco-heading-2"><a href="#" class="logo">Car<span>book</span></a></h2>
                    <p>@item.Description</p>
                    <ul class="ftco-footer-social list-unstyled float-md-left float-lft mt-5">
                        <li class="ftco-animate"><a href="#"><span class="icon-twitter"></span></a></li>
                        <li class="ftco-animate"><a href="#"><span class="icon-facebook"></span></a></li>
                        <li class="ftco-animate"><a href="#"><span class="icon-instagram"></span></a></li>
                    </ul>
                </div>
            </div>
            <div class="col-md">
                <div class="ftco-footer-widget mb-4 ml-md-5">
                    <h2 class="ftco-heading-2">Information</h2>
                    <ul class="list-unstyled">
                        <li><a href="/About/Index/" class="py-2 d-block">Hakkımızda</a></li>
                        <li><a href="/Car/Index/" class="py-2 d-block">Servisler</a></li>
                        <li><a href="#" class="py-2 d-block">Koşullar</a></li>
                        <li><a href="#" class="py-2 d-block">Best Price Guarantee</a></li>
                        <li><a href="#" class="py-2 d-block">Güvenlik ve Çerez Politikaları</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-md">
                <div class="ftco-footer-widget mb-4">
                    <h2 class="ftco-heading-2">Customer Support</h2>
                    <ul class="list-unstyled">
                        <li><a href="#" class="py-2 d-block">Sıkça sorulan sorular</a></li>
                        <li><a href="#" id="btn1" class="py-2 d-block">Ödeme Koşulları</a></li>
                        <li><a href="/CarPricing/Index/" class="py-2 d-block">Kiralama Ücretleri</a></li>
                        <li><a href="#" class="py-2 d-block">Yardım</a></li>
                        <li><a href="/Contact/Index/" class="py-2 d-block">İletişim</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-md">
                <div class="ftco-footer-widget mb-4">
                    <h2 class="ftco-heading-2">Soru Cevap</h2>
                    <div class="block-23 mb-3">
                        <ul>
                            <li><span class="icon icon-map-marker"></span><span class="text">@item.Address</span></li>
                            <li><span class="icon icon-phone"></span><span class="text">@item.Phone</span></li>
                            <li><span class="icon icon-envelope"></span><span class="text">@item.Email</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 text-center">

                <p>
