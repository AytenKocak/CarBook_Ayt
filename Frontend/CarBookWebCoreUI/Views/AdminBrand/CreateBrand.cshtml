@model CreateBrandDto

@{
    ViewData["Title"] = "CreateBrand";
    Layout = "~/Views/AdminLayout/Index.cshtml";
 
}
<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Araç Marka Girişi</h4>

                        <p class="card-subtitle mb-4">
                            Araç Markalarını bu sayfadan ekleyip,güncelleyip silebilirsiniz.
                            
                        </p>

                        <form method="post">

                            <div class="form-group">
                                <label>Marka</label>

                                <input type="text"
                                       class="form-control"
                                       asp-for="Name"
                                       placeholder="Marka Girişi Yapınız" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                               Marka Kaydet
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>