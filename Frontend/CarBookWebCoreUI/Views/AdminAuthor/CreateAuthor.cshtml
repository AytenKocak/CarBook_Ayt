@model CreateAuthorDto
@{
    ViewData["Title"] = "CreateAuthor";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Yazar   Girişi</h4>

                        <p class="card-subtitle mb-4">
                           Anasayfa Yazar bilgileri düzenleme sayfası.

                        </p>

                        <form method="post">

                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label">Ad Soyad</label>
                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Ad Soyad Girişi Yapınız" />
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ImageUrl" class="form-label">ImageUrl</label>
                                <input asp-for="ImageUrl"
                                       class="form-control"
                                       placeholder="ResimYolu Girişi Yapınız" />
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Description" class="form-label"> Açıklama</label>
                                <input asp-for="Description"
                                       class="form-control"
                                       placeholder="Açıklama Giriniz" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                              Yazar bilgisini Kaydet
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>