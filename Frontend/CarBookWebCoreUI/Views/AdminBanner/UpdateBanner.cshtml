
@model UpdateBannerDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";

}
<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Araç Banner  Girişi</h4>

                        <p class="card-subtitle mb-4">
                            Araç Banner sayfasını buradan ekeleyebilirsiniz.

                        </p>

                        <form method="post">
                            <input type="hidden" asp-for="BannerID" />
                            <div class="form-group mb-3">
                                <label asp-for="Title" class="form-label">Başlık</label>
                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Başlık Girişi Yapınız" />
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Describtion" class="form-label">Açıklama</label>
                                <input asp-for="Describtion"
                                       class="form-control"
                                       placeholder="Açıklama Girişi Yapınız" />
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="VideoUrl" class="form-label">Video Açıklama</label>
                                <input asp-for="VideoUrl"
                                       class="form-control"
                                       placeholder="Video YouTube Embed Linkini Giriniz" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                                Banner bilgisini Kaydet
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>