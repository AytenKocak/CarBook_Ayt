@model List<ResultBannerDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";

}
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Ana Sayfa Banner Alanı</h4>
                        <p class="card-subtitle mb-4">
                            Ana Sayfa alanında bulunan Banner alanını düzenleyebilirsiniz.
                            Sadece 1 adet veri girişi yapabilirisiniz.
                        </p>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Video Url</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                        <th>YouTube'da Aç</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td>@item.Describtion</td>
                                            <td>@item.VideoUrl</td>

                                            <td>
                                                <a href="/AdminBanner/RemoveBanner/@item.BannerID"
                                                   class="btn btn-outline-danger">Sil</a>
                                            </td>

                                            <td>
                                                <a href="/AdminBanner/UpdateBanner/@item.BannerID"
                                                   class="btn btn-outline-success">Güncelle</a>
                                            </td>

                                            <td>
                                                <a href="@item.VideoUrl"
                                                   target="_blank"
                                                   class="btn btn-outline-info">
                                                    YouTube'da Aç
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <br />
                            <a href="/AdminBanner/CreateBanner" class="btn btn-primary">Yeni Banner Girişi</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


