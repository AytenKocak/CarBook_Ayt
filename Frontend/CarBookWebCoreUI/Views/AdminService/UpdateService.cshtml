@model UpdateServiceDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";


}
<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Lokasyon Girişi</h4>

                        <p class="card-subtitle mb-4">
                            Yeni Hizmet Ekleyebilirsiniz

                        </p>

                        <form method="post">
                            <input type="hidden" asp-for="ServiceID" />
                            <div class="form-group mb-3">
                                <label asp-for="Title" class="form-label">Lokasyon Adı</label>
                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Hizmet Adını Girişi Yapınız" />
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="Description" class="form-label">Açıklama </label>
                                <input asp-for="Description"
                                       class="form-control"
                                       placeholder="Açıklama Girişi Yapınız" />
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="IconUrl" class="form-label">Ikon Girişi yapınız</label>
                                <input asp-for="IconUrl"
                                       class="form-control"
                                       placeholder="Ikon Girişi Yapınız" />
                            </div>

                           

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                                Hizmet bilgisini Güncelle
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>