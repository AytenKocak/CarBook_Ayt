@model List<ResultServiceDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    int count = 1;
}
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Ana Sayfa Hakkımızda Alanı</h4>
                        <p class="card-subtitle mb-4">
                            Ana Sayfa Hizmet bölümü Ekle,Sil,Güncelle işlemlerinin burdan yapabilirsiniz.
                            Tema bütünlüğünü korumak adına 4 adet veri girebilirsiniz.
                        </p>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>IconUrl</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                    
                                        <tr>
                                            <td>@count</td>
                                            <td>@item.Title</td>
                                            <td>@item.Description</td>
                                            <td>@item.IconUrl</td>
                                           
                                              <td>    
                                                <a href="/AdminService/RemoveService/@item.ServiceID" class="btn btn-outline-danger">Sil</a>
                                            </td>
                                            <td>
                                                <a href="/AdminService/UpdateService/@item.ServiceID" class="btn btn-outline-success">Güncelle</a>
                                            </td>
                                            <td>
                                                <a href="/AdminService/ServiceDetail/@item.ServiceID" class="btn btn-outline-success">Konumu Aç</a>
                                            </td>
                                        </tr>
                                        count++;
                                    }
                                </tbody>
                            </table>
                            <br />
                            <a href="/AdminService/CreateService" class="btn btn-primary">Yeni Hizmet Girişi</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>