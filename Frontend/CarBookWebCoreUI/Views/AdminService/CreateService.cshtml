@model CreateServiceDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";

}
<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Hiznet Girişi</h4>

                        <p class="card-subtitle mb-4">
                            Ana Sayfa Hizmet bölümü Ekle,Sil,Güncelle işlemlerinin burdan yapabilirsiniz.
                            Tema bütünlüğünü korumak adına 4 adet veri girebilirsiniz.

                        </p>

                        <form method="post">

                            <div class="form-group mb-3">
                                <label asp-for="Title" class="form-label">Hizmet Başlığı</label>
                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Hizmet Başlığı Girişi Yapınız" />
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                                <input asp-for="Description"
                                       class="form-control"
                                       placeholder="Açıklama Girişi Yapınız" />
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="IconUrl" class="form-label">Ikon Url</label>
                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="IkonUrl  Girişi Yapınız" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary waves-effect waves-light">
                                Hizmet bilgisini Kaydet
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>