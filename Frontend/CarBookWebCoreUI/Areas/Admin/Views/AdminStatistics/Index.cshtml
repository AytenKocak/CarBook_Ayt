                                    <i class="mdi mdi-arrow-up"></i>
                                </span>
                            </div>
                        </div>

                        <div class="progress badge-soft-light shadow-sm" style="height:7px;">
                            <div class="progress-bar bg-light"
                                 role="progressbar"
                                 style="width:@ViewBag.v1%;"></div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Kart 2 -->
